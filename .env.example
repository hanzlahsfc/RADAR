# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (PostgreSQL 16) ----
# docker-compose maps container 5432 to host 5433 to avoid clashing with an
# existing local PostgreSQL on 5432. CI uses an isolated database on 5432.
DATABASE_URL=postgresql://radar:radar@localhost:5433/radar

# ---- Telegram ----
# Never commit a real token. Obtained from @BotFather.
TELEGRAM_BOT_TOKEN=
# "polling" for local development; "webhook" for production.
TELEGRAM_TRANSPORT=polling
# Required (and secret) when TELEGRAM_TRANSPORT=webhook.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL the Telegram webhook is registered against.
PUBLIC_BASE_URL=
PORT=3000
# Optional: an explicit private chat for live smoke checks. Never a real user.
TELEGRAM_DEV_TEST_CHAT_ID=

# ---- Chain / providers ----
# These are candidates to VERIFY with `pnpm verify:network`, not trusted defaults.
# Leave CHAIN_ID and RPC_HTTP_URL empty to run in offline/disabled chain mode.
CHAIN_ID=
RPC_HTTP_URL=
EXPLORER_BASE_URL=
EXPLORER_API_BASE_URL=
EXPLORER_API_KEY=

# explorer | rpc | disabled
HISTORY_PROVIDER=explorer

# ---- Finality ----
# latest | safe | finalized | depth:<n>  (must be verified for the target network)
FINALITY_VERIFIED=false
FINALITY_MODE=
CONFIRMATION_DEPTH=

# ---- Indexer behavior ----
POLL_INTERVAL_MS=5000
INITIAL_BLOCK_BATCH_SIZE=100
MAX_BACKFILL_HOURS=72
MAX_WATCHES_PER_ACCOUNT=5
