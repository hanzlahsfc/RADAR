{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "description": "RADAR — a Telegram-first, read-only monitor for public wallet activity on Robinhood Chain.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev:bot": "tsx watch src/entrypoints/bot.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:bot": "node dist/src/entrypoints/bot.js",
    "start:worker": "node dist/src/entrypoints/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/entrypoints/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "verify:network": "tsx src/entrypoints/verify-network.ts",
    "verify:fixtures": "tsx src/entrypoints/verify-fixtures.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "viem": "2.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
